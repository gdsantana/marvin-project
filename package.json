{
  "name": "marvin-project",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages --max-warnings=0",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter @finance/web dev",
    "dev:mcp": "pnpm --filter @finance/mcp dev",
    "db:migrate": "pnpm --filter @finance/db db:migrate",
    "db:up": "docker compose --env-file .env -f infra/compose.yml -f infra/compose.dev.yml up -d db",
    "db:clean": "pnpm --filter @finance/db db:clean",
    "db:seed": "pnpm --filter @finance/db db:seed",
    "db:bootstrap-categories": "pnpm --filter @finance/db db:bootstrap-categories",
    "db:provision-owner": "pnpm --filter @finance/db db:provision-owner"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.72.0"
  }
}
