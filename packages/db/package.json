{
  "name": "@finance/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none src/**/*.test.ts",
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:clean": "node --env-file-if-exists=../../.env --import tsx src/clean.ts",
    "db:seed": "SEED_DEVELOPMENT=true node --env-file-if-exists=../../.env --import tsx src/seed.ts",
    "db:bootstrap-categories": "node --env-file-if-exists=../../.env --import tsx src/bootstrap-categories.ts",
    "db:provision-owner": "node --env-file-if-exists=../../.env --import tsx src/provision-owner.ts"
  },
  "dependencies": {
    "@finance/domain": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
