#!/bin/sh
# A worktree creation checks out from an all-zero previous HEAD.
[ "$3" = 1 ] || exit 0
case "$1" in *[!0]*) exit 0 ;; esac

main=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
current=$(git rev-parse --show-toplevel) || exit 1
[ -n "$main" ] && [ "$current" != "$main" ] || exit 0

for name in .env node_modules; do
  if [ ! -e "$main/$name" ]; then
    printf 'worktree: origem ausente: %s\n' "$main/$name" >&2
  elif [ -e "$current/$name" ] || [ -L "$current/$name" ]; then
    printf 'worktree: destino preservado: %s\n' "$current/$name" >&2
  else
    ln -s "$main/$name" "$current/$name" || exit 1
  fi
done
