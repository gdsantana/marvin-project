# Copy to .env.ops on the OPERATIONS host, chmod 600; never copy into Web/MCP.
# For Compose use --env-file .env --env-file .env.ops.
# Generate distinct URL-safe passwords: openssl rand -hex 32
# Keep the existing POSTGRES_USER/password for an existing initialized volume.
POSTGRES_PASSWORD=replace-with-the-admin-password
# Use literal, matching credentials: Node does not expand ${...} inside values.
DATABASE_ADMIN_URL=postgresql://marvin_admin:replace-with-the-admin-password@db:5432/marvin
MIGRATION_DATABASE_URL=postgresql://marvin_migrator:replace-with-the-migration-password@db:5432/marvin
# Outside Docker, use local host/port URLs here instead of host db.
