# Copy to .env on the host and replace every placeholder before starting Compose.
# Generate secrets with: openssl rand -hex 32
POSTGRES_IMAGE_TAG=17.11-alpine
POSTGRES_DB=marvin
POSTGRES_USER=marvin_admin
# Administrative password and migration URL live only in .env.ops.
DATABASE_URL=postgresql://marvin_app:replace-with-the-app-password@db:5432/marvin

# Local development commands only. Node does not expand ${...} in this value.
# The host-side development URL uses 127.0.0.1; DATABASE_URL above remains for Compose.
# Leave this unset in production.
DEV_DB_HOST_PORT=5432
# DEVELOPMENT_DATABASE_URL=postgresql://marvin_app:your-local-app-password@127.0.0.1:5432/marvin

# Must match the origin used by the trusted reverse proxy; no proxy headers are trusted by default.
APP_ORIGIN=https://finance.example.lan

# One MCP API credential shared only by the web bearer verifier and MCP HTTP client.
MCP_API_TOKEN=replace-with-a-distinct-random-api-token
# A different credential used only by Hermes to connect to apps/mcp.
MCP_HERMES_BEARER_TOKEN=replace-with-a-different-random-hermes-token
MCP_API_URL=http://web:3000/api/

# Bind to loopback when the private reverse proxy runs on the host.
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=3000
MCP_BIND_ADDRESS=127.0.0.1
MCP_HOST_PORT=3001
